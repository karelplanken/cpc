{
  "name": "compound-policy-check",
  "version": "3.0.0",
  "description": "Client-side web app that checks chemical substances (CAS RNs and H/P codes) against a laboratory compound policy.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run validate:data && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "pdfjs-dist": "^6.5.438"
  }
}
